        "package_health": {
          "$ref": "#/components/schemas/PackageHealth"
        },
        "package_id": {
          "description": "Package identifier in PURL format",
          "example": "pkg:npm/express",
          "type": "string"
        },
        "package_name": {
          "description": "Name of the package",
          "example": "express",
          "type": "string"
        }
